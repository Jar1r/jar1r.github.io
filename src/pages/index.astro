import '../styles/global.css';
import samuraiGlitch from '../assets/samurai-glitch.gif';
import quickhackImg from '../assets/quickhack.webp';
---

<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Jareer Haider // System Architecture & Hardware</title>
  </head>
  <body class="bg-[#07080c] text-slate-100 font-sans m-0 p-0">
    <CyberDashboard 
      samuraiImg={samuraiGlitch.src} 
      quickhackImg={quickhackImg.src}
      client:load 
    />
  </body>
</html>